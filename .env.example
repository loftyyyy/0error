# Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=0error
DB_USER=0error
DB_PASSWORD=0error_dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI is optional. Without a key, drills come from the static pool and coaching
# from the deterministic fallback. Any OpenAI-compatible endpoint works.
# OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4.1-mini
# Gemini through its OpenAI-compatible API:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.8-flash
# Use a model the key can access; older Gemini models are retired for new users.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
