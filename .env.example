# Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=0error
DB_USER=0error
DB_PASSWORD=0error_dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI is optional. Without a key, drills come from the static pool and coaching
# from the deterministic fallback. Any OpenAI-compatible endpoint works.
# Primary: NVIDIA Nemotron. Fallback: NVIDIA Gemma.
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
AI_FALLBACK_MODEL=google/gemma-4-31b-it
# Other providers, for reference:
#   OpenAI: AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4.1-mini
#   Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           AI_MODEL=gemini-3.8-flash
